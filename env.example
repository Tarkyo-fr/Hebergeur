# --- Général ---
PORT=4000
FRONTEND_URL=http://localhost:5173
SESSION_SECRET=change-moi
BACKEND_URL=http://localhost:4000

# --- Discord OAuth2 (créer une app sur https://discord.com/developers/applications) ---
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:4000/auth/discord/callback

# --- Twitch OAuth2 (créer une app sur https://dev.twitch.tv/console/apps) ---
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://localhost:4000/auth/twitch/callback
# Broadcaster = ta propre chaîne, nécessaire pour lire/gérer les rewards Channel Points
TWITCH_BROADCASTER_ID=

# --- YouTube Data API v3 (https://console.cloud.google.com/) ---
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=

# --- Admin ---
# ID Discord autorisé à publier le planning / giveaway / point shop
ADMIN_DISCORD_IDS=
